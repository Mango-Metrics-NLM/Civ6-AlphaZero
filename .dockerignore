# OS
.DS_Store
Thumbs.db

# Windows reserved device names (cause tar failures on Linux Docker)
# Use **/ prefix to match in any subdirectory, not just root
**/nul
**/con
**/prn
**/aux
**/com[0-9]
**/lpt[0-9]

# Other leftover artifact files
temp_log_tail.txt
end_of_log.txt
end_of_log_utf8.txt
test_output.txt
test_results.txt
training_logs_full.txt
latest_run_log.txt
debug_selfplay.log
test_error.log


# Local scratch / session artifacts (not needed in build context)
pytest_*.txt
.superpowers/

# Civ6 mod source and superpowers docs (not needed in container image)
mod/
docs/superpowers/
release-staging*/
dataset-export/

# Repository governance and agent harness — never needed at runtime, and they
# invalidate the Docker layer cache on every doc or KB edit.
.claude/
.agents/
kb/
openspec/
.github/
templates/
examples/
demos/
spaces/
k8s/
server-module/
spacetimedb_module/

# Dev tooling and lockfiles (uv.lock alone is ~868 KB)
uv.lock
.pre-commit-config.yaml
.gitleaks.toml
.hypothesis/
.tools/

# Merge/patch leftovers
*.orig
*.rej

