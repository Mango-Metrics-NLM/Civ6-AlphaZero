{
  "permissions": {
    "allow": [
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(mlflow:*)",
      "Bash(python -m alpha_zero:*)",
      "Bash(python -c:*)",
      "Bash(python --version:*)",
      "Bash(pip install:*)",
      "Bash(pip list:*)",
      "Bash(make lint:*)",
      "Bash(make typecheck:*)",
      "Bash(make test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(python3 -m ruff:*)",
      "Bash(python3 -m mypy:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 -m bandit:*)",
      "Bash(python3 -m pip:*)",
      "Bash(python3 -c:*)",
      "Bash(python3 scripts/:*)",
      "Bash(python scripts/:*)",
      "Bash(make verify:*)",
      "Bash(make validate:*)",
      "Bash(make lint-check:*)",
      "Bash(make test-all:*)",
      "Bash(make test-security:*)",
      "Bash(make test-governance:*)",
      "Bash(make security-secrets:*)",
      "Bash(make print-gitleaks-version:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(docker push:*)",
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(kubectl:*)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Write(.env)",
      "Write(.env.local)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh api -X:*)",
      "Bash(gh api * -X *)",
      "Bash(gh api --method:*)",
      "Bash(gh api * --method *)",
      "Bash(git push --tags:*)",
      "Bash(git push * --tags*)",
      "Bash(git push --follow-tags:*)",
      "Bash(git push * --follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh release:*)",
      "PowerShell(gh repo edit:*)",
      "PowerShell(gh ruleset:*)",
      "PowerShell(gh api -X:*)",
      "PowerShell(gh api * -X *)",
      "PowerShell(gh api --method:*)",
      "PowerShell(gh api * --method *)",
      "PowerShell(git push --tags:*)",
      "PowerShell(git push * --tags*)",
      "PowerShell(git push --follow-tags:*)",
      "PowerShell(git push * --follow-tags*)",
      "PowerShell(git push *refs/tags/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pretooluse_guard.sh",
            "timeout": 10,
            "statusMessage": "Checking prohibited-action guard..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sessionstart_bootstrap.sh",
            "timeout": 180,
            "statusMessage": "Bootstrapping environment..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/posttooluse_lint.sh",
            "timeout": 15,
            "statusMessage": "Linting..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/posttooluse_governance.sh",
            "timeout": 60,
            "statusMessage": "Validating governance..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/posttooluse_governance.sh",
            "timeout": 60,
            "statusMessage": "Checking debt ratchet..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/precompact_state.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"Reminder: If meaningful work was done, run the appropriate handoff skill before ending (CLAUDE.md Section 14).\"}'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "RUFF_CACHE_DIR": ".ruff_cache",
    "PYTEST_TIMEOUT": "300",
    "CIV6AZ_DEFAULT_BRANCH": "dev",
    "OMP_NUM_THREADS": "2",
    "CIV6AZ_PROTECTED_BRANCHES": "dev qa main claude/civ6-alphazero-implementation-vMnun"
  },
  "enableAllProjectMcpServers": false
}
