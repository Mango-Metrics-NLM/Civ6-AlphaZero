<?xml version="1.0" encoding="utf-8"?>
<Mod id="ALPHAZERO_AI_BRIDGE" version="1.0.0">
    <Properties>
        <Name>AlphaZero AI Bridge</Name>
        <Description>Bridge system for AlphaZero-style AI to play Civilization VI through file-based IPC.</Description>
        <Teaser>AI agent interface for Civilization VI</Teaser>
        <Authors>AlphaZero Civ6 Project</Authors>
        <AffectsSavedGames>0</AffectsSavedGames>
        <SupportsSinglePlayer>1</SupportsSinglePlayer>
        <SupportsMultiplayer>0</SupportsMultiplayer>
        <SupportsHotSeat>0</SupportsHotSeat>
        <CompatibleVersions>1.2,2.0</CompatibleVersions>
    </Properties>

    <Files>
        <File>Scripts/AlphaZeroMain.xml</File>
        <File>Scripts/AlphaZeroMain.lua</File>
        <File>Scripts/Config.lua</File>
        <File>Scripts/Logger.lua</File>
        <File>Scripts/JsonEncoder.lua</File>
        <File>Scripts/FileIO.lua</File>
        <File>Scripts/StateExporter.lua</File>
        <File>Scripts/ActionExecutor.lua</File>
        <File>Scripts/Main.lua</File>
    </Files>

    <!-- Use AddUserInterfaces (not AddGameplayScripts) so the Lua context
         has full access to UI, io, and os APIs. The XML wrapper loads
         Main.lua which then include()s the other modules. -->
    <InGameActions>
        <AddUserInterfaces id="AlphaZeroMainUI">
            <Properties>
                <Context>InGame</Context>
            </Properties>
            <File>Scripts/AlphaZeroMain.xml</File>
        </AddUserInterfaces>
    </InGameActions>
</Mod>
