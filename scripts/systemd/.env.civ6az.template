# Civ6 AlphaZero Orchestrator Environment
# Copy to /home/civ6az/.env.civ6az and fill in values

# GCP Project Settings (required)
CIV6AZ_VERTEX_PROJECT=hrmtrain
CIV6AZ_VERTEX_REGION=us-central1
CIV6AZ_GCS_BUCKET=civ6az-training
CIV6AZ_CONTAINER_IMAGE_URI=us-central1-docker.pkg.dev/hrmtrain/civ6az/civ6az-training:v1.2.0

# Weights & Biases (optional but recommended)
WANDB_API_KEY=<your-wandb-api-key>
WANDB_PROJECT=civ6-alphazero
WANDB_ENABLED=true

# Python path
PYTHONPATH=/home/civ6az/Civ6-AlphaZero
