# Cloud Build ignore patterns
# Reduces upload size for gcloud builds submit

# Version control
.git/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# W&B run data (large, not needed in container)
wandb/

# Training artifacts and model checkpoints (not part of container image)
models/
checkpoints/
outputs/
runs/
logs/

# Test data / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Documentation build
docs/_build/

# OS files
Thumbs.db
.DS_Store

# Node modules (if any JS tooling)
node_modules/

# Temporary and scratch files
*.tmp
*.bak
*.log

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# Large binary assets
*.pt
*.pth
*.onnx
*.h5
*.pkl

# Gemini/agent artifacts
.gemini/
