# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# LLM API Configuration
# =============================================================================

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_ORG_ID=                           # Optional: Organization ID
OPENAI_MODEL=gpt-4                       # Default model for OpenAI calls
OPENAI_MAX_TOKENS=4096                   # Maximum tokens for responses
OPENAI_TEMPERATURE=0.7                   # Temperature for generation (0.0-2.0)

# Anthropic API Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514     # Default model for Anthropic calls
ANTHROPIC_MAX_TOKENS=4096                # Maximum tokens for responses
ANTHROPIC_TEMPERATURE=0.7                # Temperature for generation (0.0-1.0)

# LLM Provider Selection (openai, anthropic, auto)
LLM_PROVIDER=auto                        # auto = try anthropic first, fallback to openai

# =============================================================================
# Application Configuration
# =============================================================================

# Environment
APP_ENV=development                      # development, staging, production
DEBUG=true                               # Enable debug logging
LOG_LEVEL=INFO                           # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Paths (relative to project root)
CHECKPOINT_DIR=checkpoints               # Model checkpoint directory
LOG_DIR=logs                             # Log file directory
DATA_DIR=data                            # Data directory
CONFIG_PATH=configs/civ6_config.yaml     # Default config file

# =============================================================================
# Training Configuration Overrides
# =============================================================================

# These override values from civ6_config.yaml
# Prefix with CIV6AZ_ for automatic loading by ConfigManager

# CIV6AZ_TRAINING_BATCH_SIZE=256
# CIV6AZ_TRAINING_LEARNING_RATE=0.001
# CIV6AZ_MCTS_NUM_SIMULATIONS=200
# CIV6AZ_DISTRIBUTED_NUM_ACTORS=64

# =============================================================================
# Google Cloud / Vertex AI Configuration
# =============================================================================

# GCP Project and Region (required for cloud training)
CIV6AZ_VERTEX_PROJECT=                   # Your GCP project ID
CIV6AZ_VERTEX_REGION=us-central1         # GCP region for Vertex AI
CIV6AZ_GCS_BUCKET=                       # GCS bucket name (without gs://)

# Container image for training (built with cloudbuild.yaml)
CIV6AZ_CONTAINER_IMAGE_URI=              # e.g., gcr.io/PROJECT_ID/civ6az-training:latest

# Service account (optional, uses default compute SA if not set)
CIV6AZ_VERTEX_SERVICE_ACCOUNT=           # e.g., sa-name@project.iam.gserviceaccount.com

# =============================================================================
# Distributed Training
# =============================================================================

# Ray Configuration (if using Ray for distributed training)
# RAY_ADDRESS=auto                       # Ray cluster address
# RAY_NUM_CPUS=8                         # Number of CPUs to use
# RAY_NUM_GPUS=1                         # Number of GPUs to use

# =============================================================================
# Monitoring and Observability
# =============================================================================

# TensorBoard
TENSORBOARD_ENABLED=false
TENSORBOARD_LOG_DIR=runs

# Weights & Biases (optional)
WANDB_ENABLED=false
WANDB_PROJECT=civ6-alphazero
WANDB_ENTITY=                            # Your W&B username or team name
WANDB_API_KEY=                           # Your W&B API key

# =============================================================================
# GCP Cloud Training Configuration
# =============================================================================

# GCP Core Settings (Required for cloud training)
GCP_PROJECT_ID=                          # Your GCP project ID
GCP_REGION=us-central1                   # GCP compute region
GCP_ZONE=                                # GCP compute zone (optional)

# GCS Storage (Required for cloud checkpoints)
GCS_BUCKET_NAME=                         # GCS bucket for checkpoints/artifacts

# Authentication (Optional - uses default credentials if not set)
GCP_SERVICE_ACCOUNT=                     # Service account email
GCP_NETWORK=                             # VPC network name
GCP_SUBNETWORK=                          # Subnetwork name

# Application-Specific Cloud Overrides (CIV6AZ_ prefix)
CIV6AZ_CHECKPOINT_PREFIX=checkpoints/    # GCS checkpoint path prefix
CIV6AZ_ARTIFACT_PREFIX=artifacts/        # GCS artifact path prefix
CIV6AZ_ENABLE_CLOUD_LOGGING=true         # Enable Cloud Logging
CIV6AZ_ENABLE_CLOUD_MONITORING=true      # Enable Cloud Monitoring
CIV6AZ_LOG_LEVEL=INFO                    # Cloud log level

# Compute Configuration
CIV6AZ_MACHINE_TYPE=n1-standard-8        # GCE machine type
CIV6AZ_ACCELERATOR_TYPE=NVIDIA_TESLA_T4  # GPU type (T4, V100, A100)
CIV6AZ_ACCELERATOR_COUNT=1               # Number of GPUs
CIV6AZ_REPLICA_COUNT=1                   # Training replicas

# Spot/Preemptible Instance Settings
CIV6AZ_USE_SPOT=true                     # Use spot instances (60-91% savings)
CIV6AZ_MAX_RUN_DURATION=86400            # Max job duration (seconds)
CIV6AZ_PREEMPTION_CHECK_INTERVAL=5.0     # Preemption poll interval

# =============================================================================
# Testing Configuration
# =============================================================================


# Test settings
TEST_TIMEOUT=300                         # Test timeout in seconds
TEST_COVERAGE_MIN=80                     # Minimum coverage percentage
TEST_PARALLEL=true                       # Run tests in parallel

# =============================================================================
# Security
# =============================================================================

# Secret key for any encryption needs (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
