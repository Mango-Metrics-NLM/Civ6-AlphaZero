# Dockerfile for Civ6 AlphaZero Vertex AI Training
#
# This container is optimized for GPU training on Vertex AI with:
# - NVIDIA PyTorch base image with CUDA support (T4/L4/A100 compatible)
# - All project dependencies pre-installed
# - GCP client libraries for GCS and Vertex AI integration
#
# Entry points:
#   Self-play: python -m alpha_zero.cloud.gcp.selfplay_worker
#   Training:  python -m alpha_zero.cloud.gcp.training_worker
#
# Build:
#   docker build -t civ6az:latest -f dockerfiles/Dockerfile.vertex .
#
# Test locally:
#   docker run --rm civ6az:latest python -m alpha_zero.cloud.gcp.selfplay_worker --dry_run \
#       --worker_id=0 --model_version=1 --iteration=1 --games=1

# Base image: NGC PyTorch 26.10 — Python 3.12, CUDA 13.4, PyTorch 2.15 (pre-release
# build). CUDA 13 still targets T4 (sm_75), L4 and A100; the host driver must be new
# enough for CUDA 13, which NGC's release notes do not state, so verify a Vertex job
# before relying on a new machine type. Python >= 3.11 is asserted by Cloud Build's
# check-python-version step, because PYTHONPATH (not `pip install`) means
# requires-python is never enforced here.
FROM nvcr.io/nvidia/pytorch:26.10-py3

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy container requirements (slim deps, no dev tools like mypy/ruff)
COPY requirements-container.txt .

# Install Python dependencies, pinning torch to the build NGC ships. NGC's torch is a
# pre-release (2.15.0a0+...) compiled against the image's CUDA; without the constraint a
# resolver that rejects it would pull a PyPI wheel built for a different CUDA. With it, a
# dependency that needs another torch fails the build instead of replacing it silently.
RUN python -c "import importlib.metadata as m; print('torch==' + m.version('torch'))" \
        > /tmp/torch-constraint.txt \
    && pip install --no-cache-dir -c /tmp/torch-constraint.txt -r requirements-container.txt

# Copy project source code
COPY . .

# Note: Using PYTHONPATH=/app instead of pip install -e . to avoid metadata issues
# The project is available as alpha_zero module via PYTHONPATH

# Create non-root user for security
RUN useradd -m -u 1000 trainer && chown -R trainer:trainer /app
USER trainer

# Health check - verify imports work
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "from alpha_zero.cloud.gcp import GCPConfig; print('OK')" || exit 1

# Default command - show help
CMD ["python", "-c", "print('Civ6AZ Training Container\\n\\nUsage:\\n  Self-play: python -m alpha_zero.cloud.gcp.selfplay_worker --help\\n  Training:  python -m alpha_zero.cloud.gcp.training_worker --help')"]
