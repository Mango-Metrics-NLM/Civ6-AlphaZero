# Base image for Civ6 AlphaZero containers
# Contains PyTorch, common dependencies, and the alpha_zero package
#
# Build: docker build -f dockerfiles/Dockerfile.base -t civ6-alphazero-base .

ARG PYTORCH_VERSION=2.2.0
ARG CUDA_VERSION=12.1
ARG PYTHON_VERSION=3.11

FROM pytorch/pytorch:${PYTORCH_VERSION}-cuda${CUDA_VERSION}-cudnn8-runtime

# Metadata
LABEL maintainer="Civ6-AlphaZero"
LABEL description="Base image for Civ6 AlphaZero training"
LABEL version="1.0.0"

# Environment configuration
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Application config
    CIV6_STORAGE_BACKEND=local \
    CIV6_LOG_LEVEL=INFO

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash appuser

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install GCS dependencies for cloud storage
RUN pip install --no-cache-dir \
    google-cloud-storage>=2.10.0 \
    google-cloud-aiplatform>=1.36.0 \
    gcsfs>=2023.10.0

# Copy the application code
COPY pyproject.toml setup.py ./
COPY alpha_zero/ ./alpha_zero/

# Install the package in editable mode
RUN pip install --no-cache-dir -e .

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import alpha_zero; print('OK')" || exit 1

# Default command (overridden by derived images)
CMD ["python", "-c", "print('Civ6 AlphaZero Base Image')"]
